# LLM Provider selection: 'auto', 'groq', or 'anthropic'
# If 'auto', detects whichever key is provided (prefers groq if set, or anthropic)
LLM_PROVIDER=auto

# Groq Configuration (Dev / Testing)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic Configuration (Production / Target)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5

# App Configuration
FLASK_SECRET_KEY=change-this-to-a-random-secret
PORT=5001
